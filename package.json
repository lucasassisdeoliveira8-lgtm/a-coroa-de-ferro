    "game",
    "roguelike",
    "html5-game",
    "canvas",
    "javascript",
    "philosophy",
    "brazilian-folklore",
    "educational-game",
    "pt-br"
  ],
  "scripts": {
    "check": "node ferramentas/check.js src/coroa.html && node --check /tmp/bundle.js",
    "build": "node ferramentas/build.js",
    "teste": "node testes/teste-v2.js",
    "teste:salas": "node testes/final.js",
    "teste:folclore": "node testes/folc.js",
    "teste:energia": "node testes/combate.js",
    "teste:balanco": "node testes/bal2.js",
    "teste:chegada": "node testes/chegada.js",
    "teste:trilha": "node testes/tsteste.js"
